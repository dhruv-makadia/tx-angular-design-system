{
  "name": "tx-angular-design-system",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:schematics": "tsc -p projects/core/schematics/tsconfig.json && node tools/write-schematics-pkg.mjs",
    "build:lib": "ng build core && npm run build:schematics",
    "test:lib": "ng test core --watch=false",
    "test:schematics": "npm run build:schematics && vitest run --config vitest.schematics.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/aria": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.7",
    "@angular-devkit/schematics": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@schematics/angular": "^22.1.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "jsdom": "^28.0.0",
    "jsonc-parser": "^3.3.1",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}