import { ChangeDetectionStrategy, Component, computed, input, model, output } from '@angular/core';

/**
 * <%= classify(name) %>.
 *
 * ```html
 * <<%= selector %> label="Example" />
 * ```
 */
@Component({
  selector: '<%= selector %>',
  standalone: true,
  templateUrl: './<%= dasherize(name) %>.html',
  styleUrl: './<%= dasherize(name) %>.css',
  changeDetection: ChangeDetectionStrategy.OnPush,
  host: {
    class: '<%= selector %>',
    '[class.<%= selector %>--disabled]': 'disabled()',
  },
})
export class <%= classify(prefix) %><%= classify(name) %> {
  /** Visible label. */
  readonly label = input<string>('');
  readonly disabled = input(false, { transform: booleanAttribute });

  /** Two-way bindable value. Emits `valueChange`. */
  readonly value = model<string>('');

  readonly activated = output<void>();

  protected readonly hasLabel = computed(() => this.label().length > 0);
}

function booleanAttribute(value: unknown): boolean {
  return value != null && `${value}` !== 'false';
}
