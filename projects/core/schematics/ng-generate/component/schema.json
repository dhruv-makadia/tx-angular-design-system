{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "TxDesignSystemComponent",
  "title": "Design system component",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name, without the tx- prefix.",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What should the component be called?"
    },
    "path": {
      "type": "string",
      "description": "Directory to create the component in.",
      "format": "path",
      "visible": false
    },
    "project": {
      "type": "string",
      "description": "Project to add the component to.",
      "$default": { "$source": "projectName" }
    },
    "prefix": {
      "type": "string",
      "description": "Selector prefix.",
      "default": "tx"
    },
    "skipTests": {
      "type": "boolean",
      "description": "Do not generate a spec file.",
      "default": false
    }
  },
  "required": ["name"]
}
