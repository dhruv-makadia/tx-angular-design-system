{
  "compilerOptions": {
    "lib": ["es2022", "dom"],
    /* The Angular CLI loads schematics through require(), so this build stays
       CommonJS while the library itself is ESM. */
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "outDir": "../../../dist/core/schematics",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/files/**"]
}
